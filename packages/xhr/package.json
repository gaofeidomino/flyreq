{
  "name": "@flyreq/xhr",
  "version": "0.1.0",
  "description": "FeiFly flyreq XMLHttpRequest Requestor implementation",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown && node ../../scripts/link-dts.mjs",
    "dev": "tsdown --watch"
  },
  "keywords": [
    "flyreq",
    "xhr"
  ],
  "author": "飞 (Fei)",
  "dependencies": {
    "@flyreq/core": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
