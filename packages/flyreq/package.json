{
  "name": "flyreq",
  "version": "0.1.0",
  "description": "FeiFly flyreq — single-package frontend request library with swappable transports",
  "type": "module",
  "bin": {
    "flyreq": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json",
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "require": "./dist/cli.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown && node ../../scripts/link-dts.mjs",
    "dev": "tsdown --watch"
  },
  "keywords": [
    "flyreq",
    "feifly",
    "request",
    "http",
    "axios",
    "fetch",
    "xhr"
  ],
  "author": "飞 (Fei)",
  "license": "MIT",
  "dependencies": {
    "@flyreq/axios": "workspace:*",
    "@flyreq/bus": "workspace:*",
    "@flyreq/cli": "workspace:*",
    "@flyreq/core": "workspace:*",
    "@flyreq/fetch": "workspace:*",
    "@flyreq/xhr": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
