{
  "name": "@flyreq/axios",
  "version": "0.1.0",
  "description": "FeiFly flyreq axios Requestor implementation",
  "keywords": [
    "flyreq",
    "axios"
  ],
  "homepage": "https://github.com/gaofeidomino/flyreq#readme",
  "bugs": {
    "url": "https://github.com/gaofeidomino/flyreq/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gaofeidomino/flyreq.git",
    "directory": "packages/axios"
  },
  "license": "MIT",
  "author": "飞 (Fei)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown && node ../../scripts/link-dts.mjs",
    "dev": "tsdown --watch",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@flyreq/core": "workspace:*"
  },
  "peerDependencies": {
    "axios": ">=1"
  },
  "peerDependenciesMeta": {
    "axios": {
      "optional": true
    }
  },
  "devDependencies": {
    "axios": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
