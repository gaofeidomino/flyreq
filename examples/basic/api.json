{
  "endpoints": {
    "article": {
      "publishArticle": {
        "path": "/api/article",
        "description": "发布文章",
        "method": "POST",
        "auth": true,
        "idempotent": true,
        "cache": false,
        "pager": false
      },
      "getArticles": {
        "path": "/api/article",
        "description": "获取文章",
        "method": "GET",
        "auth": false,
        "idempotent": false,
        "cache": false,
        "pager": true
      },
      "getArticleById": {
        "path": "/api/article/{id}",
        "description": "文章详情（缓存）",
        "method": "GET",
        "auth": false,
        "idempotent": false,
        "cache": true,
        "pager": false
      }
    },
    "pay": {
      "createPayment": {
        "path": "/api/pay",
        "description": "创建支付（幂等）",
        "method": "POST",
        "auth": true,
        "idempotent": true,
        "cache": false,
        "pager": false
      }
    }
  }
}
